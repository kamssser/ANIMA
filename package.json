{
  "name": "anima-studio",
  "productName": "HyperForge",
  "version": "0.20.0",
  "private": true,
  "description": "HyperForge - aplikasi Windows untuk mengelola produksi video pendek 3D (Claude + Remotion)",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,app -c blue,green \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "build": "tsc --noEmit && vite build",
    "test": "node --test \"tests/**/*.test.*\"",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "release": "npm run build && npm test && electron-builder --win nsis --publish never && node scripts/release.mjs",
    "mcp": "node mcp/server.mjs"
  },
  "build": {
    "appId": "com.hyperforge.studio",
    "productName": "HyperForge",
    "asar": true,
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.ico",
      "mcp/**",
      "shared/**",
      "remotion-template/**",
      "animate-skill/**",
      "bang-motion-skill/**",
      "studio-skill/**",
      "edu-skill/**",
      "flow-skill/**",
      "kamal-skill/**",
      "app-defaults.json",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kamssser",
        "repo": "ANIMA",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "HyperForge"
    },
    "asarUnpack": [
      "mcp/**",
      "shared/**",
      "electron/svg.cjs",
      "remotion-template/**",
      "animate-skill/**",
      "bang-motion-skill/**",
      "studio-skill/**",
      "edu-skill/**",
      "flow-skill/**",
      "kamal-skill/**",
      "node_modules/@hono/node-server/**",
      "node_modules/@modelcontextprotocol/sdk/**",
      "node_modules/@supabase/auth-js/**",
      "node_modules/@supabase/functions-js/**",
      "node_modules/@supabase/phoenix/**",
      "node_modules/@supabase/postgrest-js/**",
      "node_modules/@supabase/realtime-js/**",
      "node_modules/@supabase/storage-js/**",
      "node_modules/@supabase/supabase-js/**",
      "node_modules/accepts/**",
      "node_modules/ajv/**",
      "node_modules/ajv-formats/**",
      "node_modules/body-parser/**",
      "node_modules/bytes/**",
      "node_modules/call-bind-apply-helpers/**",
      "node_modules/call-bound/**",
      "node_modules/content-disposition/**",
      "node_modules/content-type/**",
      "node_modules/cookie/**",
      "node_modules/cookie-signature/**",
      "node_modules/cors/**",
      "node_modules/cross-spawn/**",
      "node_modules/debug/**",
      "node_modules/depd/**",
      "node_modules/dunder-proto/**",
      "node_modules/ee-first/**",
      "node_modules/encodeurl/**",
      "node_modules/es-define-property/**",
      "node_modules/es-errors/**",
      "node_modules/es-object-atoms/**",
      "node_modules/escape-html/**",
      "node_modules/etag/**",
      "node_modules/eventsource/**",
      "node_modules/eventsource-parser/**",
      "node_modules/express/**",
      "node_modules/express-rate-limit/**",
      "node_modules/fast-deep-equal/**",
      "node_modules/fast-uri/**",
      "node_modules/finalhandler/**",
      "node_modules/forwarded/**",
      "node_modules/fresh/**",
      "node_modules/function-bind/**",
      "node_modules/get-intrinsic/**",
      "node_modules/get-proto/**",
      "node_modules/gopd/**",
      "node_modules/has-symbols/**",
      "node_modules/hasown/**",
      "node_modules/hono/**",
      "node_modules/http-errors/**",
      "node_modules/iceberg-js/**",
      "node_modules/iconv-lite/**",
      "node_modules/inherits/**",
      "node_modules/ip-address/**",
      "node_modules/ipaddr.js/**",
      "node_modules/is-promise/**",
      "node_modules/isexe/**",
      "node_modules/jose/**",
      "node_modules/json-schema-traverse/**",
      "node_modules/json-schema-typed/**",
      "node_modules/math-intrinsics/**",
      "node_modules/media-typer/**",
      "node_modules/merge-descriptors/**",
      "node_modules/mime-db/**",
      "node_modules/mime-types/**",
      "node_modules/ms/**",
      "node_modules/negotiator/**",
      "node_modules/object-assign/**",
      "node_modules/object-inspect/**",
      "node_modules/on-finished/**",
      "node_modules/once/**",
      "node_modules/parseurl/**",
      "node_modules/path-key/**",
      "node_modules/path-to-regexp/**",
      "node_modules/pkce-challenge/**",
      "node_modules/proxy-addr/**",
      "node_modules/qs/**",
      "node_modules/range-parser/**",
      "node_modules/raw-body/**",
      "node_modules/require-from-string/**",
      "node_modules/router/**",
      "node_modules/safer-buffer/**",
      "node_modules/send/**",
      "node_modules/serve-static/**",
      "node_modules/setprototypeof/**",
      "node_modules/shebang-command/**",
      "node_modules/shebang-regex/**",
      "node_modules/side-channel/**",
      "node_modules/side-channel-list/**",
      "node_modules/side-channel-map/**",
      "node_modules/side-channel-weakmap/**",
      "node_modules/statuses/**",
      "node_modules/toidentifier/**",
      "node_modules/tslib/**",
      "node_modules/type-is/**",
      "node_modules/unpipe/**",
      "node_modules/vary/**",
      "node_modules/which/**",
      "node_modules/wrappy/**",
      "node_modules/zod/**",
      "node_modules/zod-to-json-schema/**"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.118.0",
    "electron-updater": "^6.8.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
