{
  "name": "anima-remotion",
  "private": true,
  "description": "Proyek Remotion untuk skill cartoon-3d-short (dirakit dari mromidev/claude-animated-shorts, MIT). Versi dikunci: sudah teruji dengan ANIMA Studio.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
